{
  "mcp": {
    "servers": {
      "robot": {
        "enabled": true,
        "transport": "stdio",
        "command": "ssh",
        "args": [
          "-T",
          "laptop",
          "bash -lc 'exec pixi run --frozen --manifest-path /home/sisyphus/worktrees/main/pixi.toml /home/sisyphus/worktrees/main/scripts/robot-mcp-launch.sh'"
        ],
        "env": {},
        "requestTimeoutMs": 120000,
        "toolFilter": {
          "include": [
            "close_gripper",
            "extend_column",
            "get_observation",
            "grasp",
            "move_gripper",
            "navigate_to",
            "open_gripper",
            "place"
          ]
        }
      }
    }
  },
  "agents": {
    "list": [
      {
        "id": "robot",
        "default": false,
        "name": "robot",
        "workspace": "~/.openclaw/agents/robot",
        "skills": [],
        "sandbox": {
          "mode": "off"
        },
        "tools": {
          "allow": [
            "robot__*"
          ]
        }
      }
    ]
  },
  "bindings": [
    {
      "agentId": "robot",
      "match": {
        "channel": "telegram",
        "accountId": "REPLACE_WITH_TELEGRAM_ACCOUNT_ID"
      }
    }
  ]
}
