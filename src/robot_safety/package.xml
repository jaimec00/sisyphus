<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_safety</name>
  <version>0.0.0</version>
  <description>Safety layer: joint/velocity/force limits, collision gate, e-stop.</description>
  <maintainer email="hejaca00@gmail.com">Jaime</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>robot_skills</depend>
  <exec_depend>python3-yaml</exec_depend>

  <!-- The Mock backend is used only to prove the seam composes (invariant 2). -->
  <test_depend>robot_backends</test_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
