<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_moveit_config</name>
  <version>0.0.0</version>
  <description>MoveIt 2 configuration for Sisyphus: SRDF, kinematics, joint limits, OMPL pipeline, and a headless move_group launch.</description>
  <maintainer email="hejaca00@gmail.com">Jaime</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_kinematics</exec_depend>
  <exec_depend>robot_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>

  <test_depend>xacro</test_depend>
  <test_depend>robot_moveit_ros_interfaces</test_depend>
  <test_depend>robot_world</test_depend>
  <test_depend>robot_world_ros</test_depend>
  <test_depend>sensor_msgs</test_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
