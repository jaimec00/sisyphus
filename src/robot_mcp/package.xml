<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_mcp</name>
  <version>0.0.0</version>
  <description>MCP tool server exposing the skill API over a robot backend.</description>
  <maintainer email="hejaca00@gmail.com">Jaime</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <depend>robot_skills</depend>
  <depend>robot_world</depend>
  <depend>robot_backends</depend>
  <!-- Every skill tool call is gated by robot_safety before the backend runs
       it (D4/D17): a runtime dependency, not a test one. -->
  <depend>robot_safety</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
