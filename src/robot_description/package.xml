<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_description</name>
  <version>0.0.0</version>
  <description>Robot description: URDF/Xacro + MJCF (3-omniwheel holonomic base + extendable column + 2 arms).</description>
  <maintainer email="hejaca00@gmail.com">Jaime</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- The description is XML, not code: this package ships no rclpy node.
       xacro is what expands robot.urdf.xacro wherever it is consumed.

       The robot_model loader (robot_model.py, PR6) reads the constants at
       *runtime* for robot_backends and (later) MuJoCo, so the two tools it
       uses — xacro to expand, urdfdom_py (urdf_parser_py) to parse — are
       exec_depend here, not merely test_depend. They are ROS-free (no rclpy /
       ament_index), which is what keeps robot_backends' "no ROS import at
       runtime" invariant intact. -->
  <exec_depend>xacro</exec_depend>
  <exec_depend>urdfdom_py</exec_depend>
  <!-- The PR7 MJCF loader (mjcf_model.py, issue #89) imports `mujoco` at
       runtime to derive the MJCF from the URDF. MuJoCo stays ROS-free (no
       rclpy / ament_index), preserving robot_backends' "no ROS import at
       runtime" invariant; it is declared here as exec_depend and pinned in
       pixi.toml so the test gate (which invokes the loader) does not depend
       on a transitive closure. -->
  <exec_depend>mujoco</exec_depend>

  <!-- The expand/parse gate (test/test_description.py) shells out to the
       xacro and check_urdf CLIs and parses the result with urdf_parser_py,
       and resolves the installed share/ dir through the ament index.
       robot_state_publisher is the fifth: the gate starts the node on the
       expanded model, because it builds a KDL tree and so rejects
       descriptions the two parsers above accept. Declared here as well as
       pinned in pixi.toml, because an acceptance criterion must not depend
       on a transitive closure. -->
  <test_depend>ament_index_python</test_depend>
  <test_depend>robot_state_publisher</test_depend>
  <test_depend>urdfdom</test_depend>
  <test_depend>xacro</test_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
