<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_description</name>
  <version>0.0.0</version>
  <description>Robot description: URDF/Xacro + MJCF (4-wheel base + extendable column + 2 arms).</description>
  <maintainer email="hejaca00@gmail.com">Jaime</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- The description is XML, not code: this package ships no rclpy node.
       xacro is what expands robot.urdf.xacro wherever it is consumed. -->
  <exec_depend>xacro</exec_depend>

  <!-- The expand/parse gate (test/test_description.py) shells out to the
       xacro and check_urdf CLIs and parses the result with urdf_parser_py,
       and resolves the installed share/ dir through the ament index. -->
  <test_depend>ament_index_python</test_depend>
  <test_depend>urdfdom</test_depend>
  <test_depend>urdfdom_py</test_depend>
  <test_depend>xacro</test_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
