<?xml version="1.0"?>
<!--
  ros2_control hardware interfaces for the Sisyphus robot (PR8b / issue #92).

  The ros2_control tag declares the MuJoCo hardware plugin and the joint
  interfaces dfki-ric's mujoco_ros2_control exposes. The MJCF (overlay.xml +
  derived pipeline) is the actuator authority; here we name the same actuator
  per joint and choose the command interface type, per the command-interface to
  MJCF-actuator-type matrix (R-PR8b-6, as adapted for dfki-ric in the probe):

    velocity command, MJCF <velocity> actuator, the 3 wheels
    position command,  MJCF <position>  actuator,  column, arm, grippers (+mirrors)

  dfki-ric's plugin is `MujocoSystem` (NOT ros-controls' MujocoSystemInterface).
  The MJCF path, sim frequency and GUI are NODE parameters (see
  mujoco.launch.py), not hardware params. dfki-ric reads URDF <mimic> tags
  natively (so the gripper mirrors below declare state interfaces only, no
  command interface); the plugin drives each mirror's own MJCF position
  actuator from the driven command x -1 (see gripper.xacro <mimic>).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="sisyphus_mujoco_control" params="">
    <ros2_control name="MujocoSystem" type="system">
      <hardware>
        <plugin>mujoco_ros2_control/MujocoSystem</plugin>
      </hardware>

      <!-- mobile base, 3 continuous wheels: velocity command -->
      <joint name="base_left_wheel">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="base_back_wheel">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="base_right_wheel">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <!-- column, 1 prismatic: position command -->
      <joint name="column_lift">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <!-- left arm, 5 revolute: position command -->
      <joint name="left_shoulder_pan">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="left_shoulder_lift">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="left_elbow_flex">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="left_wrist_flex">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="left_wrist_roll">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <!-- right arm, 5 revolute: position command -->
      <joint name="right_shoulder_pan">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="right_shoulder_lift">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="right_elbow_flex">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="right_wrist_flex">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="right_wrist_roll">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <!-- grippers, 2 driven jaws: position command -->
      <joint name="left_gripper">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="right_gripper">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <!-- gripper mirrors: mimics of the driven joints, via the URDF <mimic>
           tag in gripper.xacro (multiplier -1). dfki-ric reads that natively
           and drives each mirror's own MJCF position actuator from the driven
           command; so the mirrors declare STATE interfaces only (no command
           interface), per the dfki-ric franka-hand pattern. -->
      <joint name="left_gripper_mirror">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="right_gripper_mirror">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </ros2_control>
  </xacro:macro>

</robot>
