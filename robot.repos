# vcstool manifest — external ROS 2 source dependencies, pinned at fixed commits.
# Import with:  vcs import src < robot.repos
# Populated as we adopt/fork upstreams (see docs/design/PROJECT.md "Reuse map").
#
# PR8b (issue #92): MujocoSimulationInterface source-built via ros-controls org,
# linked against the conda mujoco 3.12.0 the Python derivation uses
# (AMENT_VENDOR_POLICY=NEVER_VENDOR), per R-PR8b-2/3/4.

repositories:
  mujoco_vendor:
    type: git
    url: https://github.com/pal-robotics/mujoco_vendor.git
    version: ff9e648e1af418c555c37cb6b4fcc42885057421
  mujoco_ros2_control:
    type: git
    url: https://github.com/ros-controls/mujoco_ros2_control.git
    version: 57fc6744844902d4532160b403fa95840c1d6f96
